# ── Required ────────────────────────────────────────────────────────────────
# JWT / session signing key — must be set before the server starts.
# In Replit, set this via: Secrets → SESSION_SECRET
# Consumed by: src/engine/config-service.ts (validateConfig) and src/bintunet-routes.ts
SESSION_SECRET=change-me-to-a-long-random-string

# ── Optional: persistence ─────────────────────────────────────────────────
# Without REDIS_URL the server runs in single-node in-memory mode.
# Stream configs will be lost on restart. For persistence, provide a Redis URL.
# REDIS_URL=redis://localhost:6379

# ── Optional: AI features ────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# ── Optional: YouTube data ───────────────────────────────────────────────
# YOUTUBE_API_KEY=...

# ── Optional: Cloudflare R2 (HLS upload / CDN replay) ───────────────────
# HLS_ENABLED=true
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=bintunet-hls
# CDN_BASE_URL=https://cdn.example.com

# ── Optional: Payments ───────────────────────────────────────────────────
# PAYSTACK_SECRET_KEY=sk_live_...

# ── Optional: admin password (default: bintunet) ─────────────────────────
# BINTUNET_PASSWORD=bintunet
